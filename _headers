# Cloudflare Pages Custom Headers Configuration
# SD Kristen Satya Wacana Salatiga (SD Lab UKSW)

# 1. HTML Documents: Cache at Edge for 1 hour with stale-while-revalidate for instant TTFB (~20ms), no client lock
/*.html
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

/
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# 2. Static CSS & JavaScript: Cache for 30 days
/css/*
  Cache-Control: public, max-age=2592000, immutable
  X-Content-Type-Options: nosniff

/js/*
  Cache-Control: public, max-age=2592000, immutable
  X-Content-Type-Options: nosniff

# 3. Optimized Images: Cache for 30 days
/images/*
  Cache-Control: public, max-age=2592000, immutable
  X-Content-Type-Options: nosniff

# 4. Web Fonts: Cache for 1 year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
